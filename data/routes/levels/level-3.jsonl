{"pattern_id":"P005","skeleton":"〔权利或义务〕＋成立条件","slots":["权利或义务","成立条件"],"research_types":["doctrinal","case"],"levels":[2,3],"legal_tasks":["成立判断","条件审查"],"department_scope":["all"],"positive_rule":"各条件有明确规范依据并能逐项审查。","negative_rule":"不得用条件清单掩盖规范依据不足。","source_basis":"A1/A2正文目录的结构性派生","source_exposure":"不含期刊原始标题","use_limit":"structure_only","review_status":"pending_human_review"}
{"pattern_id":"P006","skeleton":"〔行为〕＋构成要件","slots":["行为","构成要件"],"research_types":["doctrinal","case"],"levels":[2,3],"legal_tasks":["要件分析","行为定性"],"department_scope":["all"],"positive_rule":"材料足以支持要件化审查，且要件彼此不可互换。","negative_rule":"不得为追求整齐机械拆成固定三项或四项。","source_basis":"A1/A2正文目录的结构性派生","source_exposure":"不含期刊原始标题","use_limit":"structure_only","review_status":"pending_human_review"}
