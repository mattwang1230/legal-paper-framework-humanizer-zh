{
  "schema_version": "legal-title-routing.v1",
  "purpose": "按部门法、研究类型和正文标题层级加载最小必要的公开派生文件。",
  "runtime": {
    "script_required": false,
    "third_party_dependencies": [],
    "encoding": "UTF-8",
    "path_mode": "relative_to_skill_root"
  },
  "evidence_boundary": {
    "department_routing": "B级关键词只负责领域路由，不提供正文目录层级或实体法结论。",
    "pattern_basis": "结构骨架由A1/A2正文目录抽象派生，不含期刊原始标题。",
    "generation_limit": "骨架只约束标题结构；不得新增事实、案例、法条、文献或法律结论。"
  },
  "load_protocol": [
    "先判断部门法、研究类型和需要处理的标题层级。",
    "每个明确轴只加载其file字段指向的小文件；整篇框架可以加载多个层级文件。",
    "从层级文件取得骨架定义，再用部门法文件和研究类型文件中的preferred_pattern_ids取交集。",
    "交集为空时保留层级文件中的最小骨架，但必须补足具体法律对象并遵守证据上限。",
    "日常生成不加载data/title_patterns.jsonl；该文件只用于完整审计、维护和一致性测试。",
    "部门法或研究类型不明确时跳过该轴，不得为凑路由加载全部文件。"
  ],
  "multi_label_policy": {
    "departments": "确属交叉研究时最多加载两个部门法文件，并说明主次。",
    "research_types": "混合研究最多加载两个研究类型文件；以承担中心命题的方法为主。",
    "levels": "只加载用户要求修改的层级；全框架审改可加载一级、二级、三级三个文件。"
  },
  "audit_master": "data/title_patterns.jsonl",
